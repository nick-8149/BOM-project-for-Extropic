# ===========================================================
# BOM Verification cum Obsolescence Manager — Configuration
# ===========================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ---------- Application ----------
APP_NAME="BOM Verification cum Obsolescence Manager"
APP_VERSION="0.1.0"
DEBUG=true

# ---------- Database ----------
# SQLite (development)
DATABASE_URL=sqlite+aiosqlite:///./bom_manager.db

# PostgreSQL (production) — uncomment when ready
# DATABASE_URL=postgresql+asyncpg://bom_user:bom_password@localhost:5432/bom_manager

# ---------- Authentication ----------
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# ---------- CORS ----------
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ---------- File Upload ----------
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# ---------- Matching ----------
FUZZY_MATCH_THRESHOLD=75
HIGH_CONFIDENCE_THRESHOLD=90
MEDIUM_CONFIDENCE_THRESHOLD=70
LOW_CONFIDENCE_THRESHOLD=50

# ---------- EOL Alert ----------
EOL_ALERT_THRESHOLD_YEARS=2

# ---------- Email (future) ----------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
