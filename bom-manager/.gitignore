# ============================================================
# BOM Verification & Obsolescence Management — .gitignore
# ============================================================

# ── Environment & Secrets ────────────────────────────────────
.env
.env.*
!.env.example
*.env
*.key
*.pem

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
.pytest_cache/
*.egg-info/
dist/
build/
*.egg

# ── Virtual Environments ─────────────────────────────────────
venv/
.venv/
env/
ENV/

# ── Databases & Backups ──────────────────────────────────────
*.db
*.db-shm
*.db-wal
*.db.backup*
*.sqlite3

# ── Node.js / Frontend ──────────────────────────────────────
node_modules/
frontend/dist/
.vite/
*.tsbuildinfo

# ── OS & Editor Artifacts ────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# ── Logs & Temporary Files ───────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# Environment and secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.pyo
venv/
.venv/

# Database
*.db
*.sqlite
*.sqlite3

# Backups
*_backup_*/
*_backup_*.db
*.bak

# Uploaded files
backend/uploads/
backend/uploads_backup_*/

# Temporary files
*.log
.DS_Store